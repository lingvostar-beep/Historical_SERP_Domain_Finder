# Copy to .env and fill in. Never commit .env.
# Inventory / rotation: docs/secrets.md
# Local DB ports (docker compose): Postgres 5433, Redis 6380
# VPS DB ports (docker-compose.vps.yml): Postgres 5434, Redis 6381

# --- App ---
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8872
# Internal panel auth (HTTP Basic). Change in any shared deploy.
APP_BASIC_USER=admin
APP_BASIC_PASSWORD=change-me

# --- Database (docker-compose defaults) ---
DATABASE_URL=postgresql+psycopg://hsdf:hsdf@127.0.0.1:5433/hsdf

# --- Redis (queue in 1b+) ---
REDIS_URL=redis://127.0.0.1:6380/0

# --- DataForSEO (HTTP Basic: login + password) ---
# https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Spike 2026-11-19: usable history ≈ last 365 days only
DATAFORSEO_MAX_HISTORY_DAYS=365
DATAFORSEO_PRIMARY_SOURCE=dataforseo_google_current
DATAFORSEO_REFERENCE_PRICE_PER_SNAPSHOT=0.00012
DATAFORSEO_CONCURRENCY=5
DATAFORSEO_MAX_RETRIES=3
DATAFORSEO_RETRY_BASE_SECONDS=1.0

# --- WhoisFreaks Domain Availability ---
# https://whoisfreaks.com/ (API key; backend only — never log full URLs with apiKey)
WHOISFREAKS_API_KEY=
WHOISFREAKS_CACHE_TTL_HOURS=24
WHOISFREAKS_REFERENCE_USD_PER_CREDIT=0.004
# Bulk RPM token bucket (5k pack ≈ 8, 50k ≈ 20). Retries honour 429/Retry-After.
WHOISFREAKS_BULK_RPM=8
WHOISFREAKS_MAX_RETRIES=3
WHOISFREAKS_RETRY_BASE_SECONDS=1.0

# --- GoDaddy Domains API (optional Confirm live; deferred if empty) ---
GODADDY_PAT=
# GODADDY_API_BASE=https://api.godaddy.com

# --- Storage ---
RAW_STORAGE_DIR=data/raw
LOCATIONS_CACHE_PATH=data/cache/locations_and_languages.json
LOCATIONS_CACHE_TTL_HOURS=24
